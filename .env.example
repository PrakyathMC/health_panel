[TEMPLATE]
# ============================================================
# PulsePanel - Configuration
# ============================================================
# Copy this file to .env and edit the values:
#   cp .env.example .env
# ============================================================

# ============================================================
# Docker Compose — Database Services
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=pulsepanel
POSTGRES_PASSWORD=pulsepanel_secret
POSTGRES_DB=pulsepanel

# --- Qdrant ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_LOG_LEVEL=INFO

# --- Neo4j ---
# Format: neo4j/password
NEO4J_AUTH=neo4j/pulsepanel_graph
NEO4J_PASSWORD=pulsepanel_graph
NEO4J_HEAP_SIZE=2G
NEO4J_PAGE_CACHE=1G

# ============================================================
# OpenAI — Embedding API
# ============================================================
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ============================================================
# PulsePanel Orchestrator — Python Application Settings
# ============================================================
# These are read by pulsepanel_orchestrator/config/settings.py
# and override the baked-in defaults.

# --- PostgreSQL Connection ---
# Format: postgresql://user:password@host:port/database
PULSEPANEL_POSTGRES_DSN=postgresql://pulsepanel:pulsepanel_secret@localhost:5432/pulsepanel

# --- Qdrant Connection ---
PULSEPANEL_QDRANT_URL=http://localhost:6333
PULSEPANEL_QDRANT_COLLECTION=clinical_knowledge

# --- Neo4j Connection ---
PULSEPANEL_NEO4J_URI=bolt://localhost:7687
PULSEPANEL_NEO4J_USER=neo4j
PULSEPANEL_NEO4J_PASSWORD=pulsepanel_graph

# --- Embedding Model ---
PULSEPANEL_EMBEDDING_MODEL=text-embedding-3-large
PULSEPANEL_EMBEDDING_DIMENSIONS=3072

# --- Retrieval Weights ---
PULSEPANEL_TOP_K=10
PULSEPANEL_ENABLE_QDRANT_SEMANTIC=false
PULSEPANEL_SEMANTIC_WEIGHT=0.25
PULSEPANEL_KEYWORD_WEIGHT=0.25
PULSEPANEL_SYMBOLIC_WEIGHT=0.35
PULSEPANEL_GRAPH_WEIGHT=0.15

# --- Pipeline ---
PULSEPANEL_TOOL_TIMEOUT=30.0
PULSEPANEL_ENABLE_AUDIT=true
