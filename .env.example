# ============================================================
# PulsePanel - Configuration
# ============================================================
# Copy this file to .env and edit the values:
#   cp .env.example .env
# ============================================================

# ============================================================
# OpenAI — Embedding API
# ============================================================
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# ============================================================
# PostgreSQL (Neon / Remote)
# ============================================================
# Format: postgresql://user:password@host/database?sslmode=require
PULSEPANEL_POSTGRES_DSN=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ============================================================
# Qdrant Cloud (Remote)
# ============================================================
# Get your API key from Qdrant Cloud dashboard
PULSEPANEL_QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io
PULSEPANEL_QDRANT_API_KEY=your-qdrant-api-key
PULSEPANEL_QDRANT_COLLECTION=clinical_knowledge

# ============================================================
# Neo4j AuraDB (Remote)
# ============================================================
# URI format: neo4j+s://<instance-id>.databases.neo4j.io
PULSEPANEL_NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
PULSEPANEL_NEO4J_USER=your-username
PULSEPANEL_NEO4J_PASSWORD=your-password

# ============================================================
# PulsePanel Orchestrator — Application Settings
# ============================================================

# --- Embedding Model ---
PULSEPANEL_EMBEDDING_MODEL=text-embedding-3-large
PULSEPANEL_EMBEDDING_DIMENSIONS=3072

# --- Retrieval Weights ---
PULSEPANEL_TOP_K=10
PULSEPANEL_SEMANTIC_WEIGHT=0.25
PULSEPANEL_KEYWORD_WEIGHT=0.25
PULSEPANEL_SYMBOLIC_WEIGHT=0.35
PULSEPANEL_GRAPH_WEIGHT=0.15

# --- Pipeline ---
PULSEPANEL_TOOL_TIMEOUT=30.0
PULSEPANEL_ENABLE_AUDIT=true
PULSEPANEL_ENABLE_QDRANT_SEMANTIC=true
